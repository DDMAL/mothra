apiVersion: v1
kind: Secret
metadata:
  name: mothra-secrets-staging
  namespace: mothra
  labels:
    mothra.env: staging
type: Opaque
stringData:
  # Must differ from production's MOTHRA_SECRET: a shared signing key would let a
  # production JWT validate against the staging database, where the same `sub`
  # maps to a different user.
  MOTHRA_SECRET: "REPLACE_WITH_openssl_rand_hex_32"
  # Staging has its own Postgres *instance* (mothra-staging-postgres, deployed
  # from the separate Postgres repo into the `postgres` namespace). The database
  # name is the same as production's — only the host differs, so double-check the
  # hostname here: pointing at `mothra-postgres` would have staging's
  # _migrate_db() ALTER production's tables, and nothing would fail or warn.
  DATABASE_URL: "postgresql://mothra:CHANGE_ME@mothra-staging-postgres.postgres.svc.cluster.local:5432/mothra"

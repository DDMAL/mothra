apiVersion: v1
kind: Secret
metadata:
  name: mothra-secrets
  namespace: mothra
type: Opaque
stringData:
  MOTHRA_SECRET: "REPLACE_WITH_openssl_rand_hex_32"
  DATABASE_URL: "postgresql://mothra:CHANGE_ME@mothra-postgres.postgres.svc.cluster.local:5432/mothra"
  # Cantus Ultimus deposit token (cu_api.py), from CU's own
  # `manage.py create_deposit_user`, which prints it. Each environment needs
  # the token issued by ITS OWN CU -- a shared one would let staging write into
  # production CU's review queue. Optional: leave it out and the submission
  # page reports the feature as unconfigured rather than failing.
  CU_DEPOSIT_TOKEN: "REPLACE_WITH_CU_create_deposit_user_TOKEN"

# Copy to .env and fill in real values (cp .env.sample .env). Docker Compose
# auto-loads this file — see CLAUDE.md for details. Separate from
# landing-page/scripts/.env, which is used by local, non-Docker dev instead.

# Required — `docker compose up` fails immediately without these.
# POSTGRES_PASSWORD is both the bundled postgres service's password and the
# credential in docker-compose.yml's DATABASE_URL fallback, so pick any
# non-guessable value. Only read at initdb: changing it later means
# recreating the pgdata volume (`docker compose down -v`).
POSTGRES_PASSWORD=
MOTHRA_SECRET=

# Optional — defaults to the bundled postgres service using POSTGRES_PASSWORD
# above. Set it to point backend/worker/ic at an external or managed database.
# DATABASE_URL=postgresql://user:password@host/dbname

# Optional — docker-compose.yml has working defaults for these.
# IC_PUBLIC_URL=http://localhost:8000
# ALLOWED_ORIGINS=http://localhost:5173

# Optional off switch for the real pitch-finding stage (0/false/no falls back
# to encode_to_mei.py's geometric placeholder pitch). On when unset.
# MOTHRA_PITCH_FINDING=0

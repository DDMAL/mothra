# Copy to .env and fill in real values (cp .env.sample .env). Used by local,
# non-Docker dev — see ../../CLAUDE.md and ../README.md for details.

# Required — the backend fails to start without these.
DATABASE_URL=postgresql://user:password@host/dbname
MOTHRA_SECRET=

# Optional — all have working defaults in config.yaml; uncomment to override.
# STORAGE_QUOTA_MB=500
# IC_API_URL=http://localhost:8000
# IC_PUBLIC_URL=http://localhost:8000
# TEXT_API_URL=http://localhost:8002
# CELERY_BROKER_URL=redis://localhost:6379/0
# ALLOWED_ORIGINS=*

# Dev-only: skip ultralytics on machines that can't run it. Uploaded YOLO
# checkpoints are stored without inspection (map classes by hand afterwards).
# Pair with VITE_SKIP_PREDICT=1 in the frontend (landing-page/.env.local) so the
# predict step is bypassed and "Continue" goes straight to the IC step.
# MOTHRA_SKIP_YOLO=1
